# --- Core App ---
WEBSITE_URL=http://localhost:5000
VERCEL_ENV=development
LOG_LEVEL=DEBUG
LOGGING_AUTO_CONFIG=true

# --- Content Validation ---
MIN_WORD_COUNT=60
MIN_DESCRIPTION_LENGTH=60
MAX_DESCRIPTION_LENGTH=10000
MIN_FEEDBACK_LENGTH=5
MAX_FEEDBACK_LENGTH=2000
MIN_RATING=1
MAX_RATING=10
TOO_FAST_SECONDS=5.0

# --- Attention / Priority Logic ---
ATTENTION_FLAG_THRESHOLD=0.60
ATTENTION_FLAG_MIN_CHECKS=3
ATTENTION_HARD_FLAG_CONSEC_FAILS=2
ATTENTION_MIN_DISTINCT_WORDS=12
ATTENTION_MIN_CHAR_LENGTH=120
ATTENTION_INTERVAL=4
PRIORITY_WORD_THRESHOLD=500
PRIORITY_ROUNDS_THRESHOLD=3
PRIORITY_ATTENTION_THRESHOLD=0.75
PRIORITY_MIN_SUBMISSIONS=3

# --- Performance / Upload Limits ---
PERFORMANCE_LOG_SAMPLE_RATE=1.0
MAX_CONTENT_LENGTH_MB=8

# --- UPI / Payment ---
UPI_VPA=iamgaurav225@okaxis
UPI_NAME=cognit
PAYMENT_AMOUNT=1
PAYMENT_SECRET=Gaurav@0809

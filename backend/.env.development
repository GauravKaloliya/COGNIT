# =====================================================
# C.O.G.N.I.T. Backend Development Environment
# =====================================================

# --- Core App ---
WEBSITE_URL=http://localhost:5000
VERCEL_ENV=development
LOG_LEVEL=DEBUG
LOGGING_AUTO_CONFIG=true

# --- Content Validation ---
MIN_WORD_COUNT=60
MIN_DESCRIPTION_LENGTH=60
MAX_DESCRIPTION_LENGTH=10000
MIN_FEEDBACK_LENGTH=5
MAX_FEEDBACK_LENGTH=2000
MIN_RATING=1
MAX_RATING=10
TOO_FAST_SECONDS=5.0

# --- Attention / Priority Logic ---
ATTENTION_FLAG_THRESHOLD=0.60
ATTENTION_FLAG_MIN_CHECKS=3
ATTENTION_HARD_FLAG_CONSEC_FAILS=2
ATTENTION_MIN_DISTINCT_WORDS=12
ATTENTION_MIN_CHAR_LENGTH=120
ATTENTION_INTERVAL=4
PRIORITY_WORD_THRESHOLD=500
PRIORITY_ROUNDS_THRESHOLD=3
PRIORITY_ATTENTION_THRESHOLD=0.75
PRIORITY_MIN_SUBMISSIONS=3

# --- Performance / Upload Limits ---
PERFORMANCE_LOG_SAMPLE_RATE=0.10
ENABLE_PERFORMANCE_METRICS=false
HEALTH_CACHE_TTL_SECONDS=5
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
PARTICIPANT_CACHE_TTL_SECONDS=600
IMAGE_POOL_CACHE_TTL_SECONDS=60
MAX_CONTENT_LENGTH_MB=8

# --- UPI / Payment ---
UPI_VPA=iamgaurav225@okaxis
UPI_NAME=cognit
PAYMENT_AMOUNT=1
PAYMENT_SECRET=Gaurav@0809
PAYMENT_EXPIRY_SECONDS=300
PAYMENT_SCREENSHOT_TIMEZONE=Asia/Kolkata
PAYMENT_VERIFICATION_MAX_TIME_DIFF_SECONDS=300

# --- OCR / Fraud ---
MIN_OCR_CONFIDENCE=30
MIN_IMAGE_WIDTH=400
IMAGE_VALIDATE_URL_AVAILABILITY=false
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
MAX_FRAUD_SCORE=80.0
ENABLE_DUPLICATE_DETECTION=true
ENABLE_DEVICE_FINGERPRINTING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ERROR_LOGGING=true

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=cognitapi

# --- Security ---
IP_HASH_SALT=10
SECRET_KEY=Gaurav0809

# --- Database ---
DATABASE_URL=postgresql://neondb_owner:npg_XGug6dnRMl9j@ep-super-cloud-aif6l6hr-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_SSLMODE=auto

# --- CORS / Rate Limiting ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=true
TRUST_PROXY_HEADERS=true
RATELIMIT_STORAGE_URI=rediss://default:AYWDAAIncDJlZjNmZmZjNjQ2MTc0Njg0YjViZDRjZTk0YzdhZmEwNnAyMzQxNzk@dear-raptor-34179.upstash.io:6379
ROOT_RATE_LIMIT=30 per minute
DOCS_RATE_LIMIT=30 per minute
PARTICIPANT_CREATE_RATE_LIMIT=30 per minute
PARTICIPANT_CHECK_RATE_LIMIT=30 per minute
CONSENT_RATE_LIMIT=20 per minute
PARTICIPANT_PAYMENT_STATUS_RATE_LIMIT=30 per minute
SUBMIT_RATE_LIMIT=60 per minute
PAYMENT_CREATE_RATE_LIMIT=20 per minute
PAYMENT_VERIFY_UPLOAD_RATE_LIMIT=20 per minute
PAYMENT_STATUS_RATE_LIMIT=30 per minute
ENGAGEMENT_TRACK_RATE_LIMIT=120 per minute
ENGAGEMENT_EVENT_HISTORY_LIMIT=100
OFFLINE_ENGAGEMENT_QUEUE_MAX=200
IMAGE_PICK_ATTEMPTS_ATTENTION=4
IMAGE_PICK_ATTEMPTS_NON_ATTENTION=8
IMAGE_PICK_ATTEMPTS_FALLBACK=10
DOCS_BASE_URL=http://localhost:5000

# --- Security headers ---
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()
SECURITY_CONTENT_TYPE_OPTIONS=nosniff
SECURITY_XSS_PROTECTION=0

# --- Runtime ---
FLASK_ENV=development
PORT=5000
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

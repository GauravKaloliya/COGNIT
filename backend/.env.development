# =====================================================
# C.O.G.N.I.T. DEVELOPMENT ENVIRONMENT
# =====================================================
# This file is for local development purposes only
# Copy values from your local development environment

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# Local PostgreSQL or Neon development database
DATABASE_URL="postgresql://username:password@localhost:5432/cognit_dev?sslmode=require"

# =====================================================
# FLASK CONFIGURATION
# =====================================================
# Development secret key (use python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="dev-secret-key-32-characters-minimum-for-development"

FLASK_ENV=development

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================
WEBSITE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# =====================================================
# SECURITY
# =====================================================
# Development IP hash salt
IP_HASH_SALT="dev-ip-hash-salt-32-chars-for-development"

# =====================================================
# SURVEY CONSTRAINTS
# =====================================================
MIN_WORD_COUNT=60
MIN_DESCRIPTION_LENGTH=60
MAX_DESCRIPTION_LENGTH=10000
MIN_FEEDBACK_LENGTH=5
MAX_FEEDBACK_LENGTH=2000
MIN_RATING=1
MAX_RATING=10
TOO_FAST_SECONDS=5.0
SURVEY_ROUNDS=1
PRIORITY_MIN_SUBMISSIONS=3

# =====================================================
# ATTENTION & QUALITY
# =====================================================
ATTENTION_FLAG_THRESHOLD=0.60
ATTENTION_FLAG_MIN_CHECKS=3
PRIORITY_WORD_THRESHOLD=500
PRIORITY_ROUNDS_THRESHOLD=3
PRIORITY_ATTENTION_THRESHOLD=0.75

# =====================================================
# RATE LIMITING
# =====================================================
# Use in-memory for local development
RATELIMIT_STORAGE_URI=memory://

# =====================================================
# PAYMENT CONFIGURATION
# =====================================================
# For development, you can use test values or skip payments
UPI_VPA="test@upi"
UPI_NAME="Test User"
PAYMENT_SECRET="dev-payment-secret-32-chars-minimum"
PAYMENT_AMOUNT=1
PAYMENT_CURRENCY=INR
PAYMENT_EXPIRY_SECONDS=300

# =====================================================
# AWS S3 (Optional for development)
# =====================================================
# You can use local MinIO or AWS test credentials
AWS_ACCESS_KEY_ID=test-access-key
AWS_SECRET_ACCESS_KEY=test-secret-key
AWS_REGION=us-east-1
S3_BUCKET=cognit-dev

# =====================================================
# SERVER CONFIGURATION
# =====================================================
PORT=5000

# =====================================================
# PERFORMANCE & MONITORING
# =====================================================
PERFORMANCE_LOG_SAMPLE_RATE=1.0  # Log all requests in development

# =====================================================
# FRAUD DETECTION
# =====================================================
# Relaxed settings for development
MAX_FRAUD_SCORE=80.0
ENABLE_DUPLICATE_DETECTION=true

# =====================================================
# ADVANCED FEATURES
# =====================================================
ENABLE_DEVICE_FINGERPRINTING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ERROR_LOGGING=true

# =====================================================
# TESTING
# =====================================================
# Enable test mode for development (skip payments)
TEST_MODE=true
TEST_PAYMENT_AMOUNT=0

# =====================================================
# LOGGING
# =====================================================
LOG_LEVEL=DEBUG

# =====================================================
# OCR & IMAGE PROCESSING
# =====================================================
MIN_OCR_CONFIDENCE=30  # Lower threshold for test images
MIN_IMAGE_WIDTH=400    # Lower threshold for test images
# =====================================================
# C.O.G.N.I.T. Backend Development Environment
# =====================================================

# --- Core App ---
WEBSITE_URL=http://localhost:5000
VERCEL_ENV=development
LOG_LEVEL=DEBUG
LOGGING_AUTO_CONFIG=true

# --- Content Validation ---
MIN_WORD_COUNT=60
MIN_DESCRIPTION_LENGTH=60
MAX_DESCRIPTION_LENGTH=10000
MIN_FEEDBACK_LENGTH=5
MAX_FEEDBACK_LENGTH=2000
MIN_RATING=1
MAX_RATING=10
TOO_FAST_SECONDS=5.0

# --- Attention / Priority Logic ---
ATTENTION_FLAG_THRESHOLD=0.60
ATTENTION_FLAG_MIN_CHECKS=3
ATTENTION_HARD_FLAG_CONSEC_FAILS=2
ATTENTION_MIN_DISTINCT_WORDS=12
ATTENTION_MIN_CHAR_LENGTH=120
ATTENTION_INTERVAL=4
PRIORITY_WORD_THRESHOLD=500
PRIORITY_ROUNDS_THRESHOLD=3
PRIORITY_ATTENTION_THRESHOLD=0.75
PRIORITY_MIN_SUBMISSIONS=3
SURVEY_ROUNDS=1

# --- Performance / Upload Limits ---
PERFORMANCE_LOG_SAMPLE_RATE=1.0
MAX_CONTENT_LENGTH_MB=8

# --- UPI / Payment ---
UPI_VPA=test@upi
UPI_NAME=Test User
PAYMENT_AMOUNT=1
PAYMENT_SECRET=dev-payment-secret-32-characters-minimum
PAYMENT_EXPIRY_SECONDS=300

# --- OCR / Fraud ---
MIN_OCR_CONFIDENCE=30
MIN_IMAGE_WIDTH=400
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
MAX_FRAUD_SCORE=80.0
ENABLE_DUPLICATE_DETECTION=true
ENABLE_DEVICE_FINGERPRINTING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ERROR_LOGGING=true

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=test-access-key
AWS_SECRET_ACCESS_KEY=test-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=cognit-dev

# --- Security ---
IP_HASH_SALT=dev-ip-hash-salt-32-chars-for-development
SECRET_KEY=dev-secret-key-32-characters-minimum-for-development

# --- Database ---
DATABASE_URL=postgresql://neondb_owner:npg_XGug6dnRMl9j@ep-super-cloud-aif6l6hr-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_SSLMODE=auto

# --- CORS / Rate Limiting ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=true
RATELIMIT_STORAGE_URI=memory://

# --- Runtime ---
FLASK_ENV=development
PORT=5000

# =====================================================
# C.O.G.N.I.T. Backend Environment Variables
# =====================================================
# Copy this file to .env and fill in the required values
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"

# --- Core App ---
WEBSITE_URL=http://localhost:5000
VERCEL_ENV=development
LOG_LEVEL=INFO

# --- Fraud & Moderation ---
MAX_FRAUD_SCORE=50.0
ENABLE_DUPLICATE_DETECTION=true
ENABLE_DEVICE_FINGERPRINTING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ERROR_LOGGING=true
MIN_OCR_CONFIDENCE=55
MIN_IMAGE_WIDTH=600
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# --- UPI / Payment ---
UPI_VPA=
UPI_NAME=
PAYMENT_AMOUNT=1

# --- Priority & Attention Logic ---
PRIORITY_ROUNDS_THRESHOLD=3
PRIORITY_ATTENTION_THRESHOLD=0.75
PRIORITY_WORD_THRESHOLD=500
ATTENTION_FLAG_THRESHOLD=0.60
ATTENTION_FLAG_MIN_CHECKS=3
TOO_FAST_SECONDS=5.0

# --- Content Validation ---
MIN_DESCRIPTION_LENGTH=60
MAX_DESCRIPTION_LENGTH=10000
MIN_FEEDBACK_LENGTH=5
MAX_FEEDBACK_LENGTH=2000
MIN_RATING=1
MAX_RATING=10
MIN_WORD_COUNT=60

# --- Performance ---
PERFORMANCE_LOG_SAMPLE_RATE=0.10

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=cognitapi

# --- Security ---
IP_HASH_SALT=

# --- Backend Config ---
# CORS_ORIGINS: Comma-separated list of allowed frontend origins
# For production: CORS_ORIGINS=https://cognit.online,https://www.cognit.online
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=true
DATABASE_URL=
FLASK_ENV=development
PORT=5000
RATELIMIT_STORAGE_URI=memory://
SECRET_KEY=

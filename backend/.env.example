# =====================================================
# C.O.G.N.I.T. Backend Environment Variables
# =====================================================
# Version: 1.0.0
# Last Updated: 2024

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# PostgreSQL connection string - REQUIRED
# Format: postgresql://username:password@host:port/database?sslmode=require
# For Neon: postgresql://user:pass@ep-xxx.aws.neon.tech/db?sslmode=require&channel_binding=require
DATABASE_URL=

# =====================================================
# FLASK CONFIGURATION
# =====================================================
# SECRET_KEY - REQUIRED (use a long random string in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Flask environment (development|production)
FLASK_ENV=development

# =====================================================
# APPLICATION BASE URL
# =====================================================
# Base URL of your application
# Used for API documentation, CORS, and absolute URLs
WEBSITE_URL=http://localhost:5000

# CORS Configuration
# Comma-separated list of allowed origins
# Example: https://cognit.online,https://www.cognit.online
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# =====================================================
# SECURITY & HASHING
# =====================================================
# IP anonymization salt - REQUIRED
# Use a long random string to hash IP addresses
# Generate with: openssl rand -hex 32
IP_HASH_SALT=

# =====================================================
# SURVEY CONFIGURATION
# =====================================================
# Description and feedback constraints
MIN_WORD_COUNT=60
MIN_DESCRIPTION_LENGTH=60
MAX_DESCRIPTION_LENGTH=10000
MIN_FEEDBACK_LENGTH=5
MAX_FEEDBACK_LENGTH=2000

# Rating constraints
MIN_RATING=1
MAX_RATING=10

# Time-based validation
TOO_FAST_SECONDS=5.0

# Survey rounds configuration
SURVEY_ROUNDS=1
PRIORITY_MIN_SUBMISSIONS=3

# =====================================================
# ATTENTION & QUALITY CHECKING
# =====================================================
# Attention check flagging threshold (0.0 to 1.0)
# Participants below this score with min checks are flagged
ATTENTION_FLAG_THRESHOLD=0.60

# Minimum number of attention checks before flagging
ATTENTION_FLAG_MIN_CHECKS=3

# Priority eligibility thresholds
PRIORITY_WORD_THRESHOLD=500
PRIORITY_ROUNDS_THRESHOLD=3
PRIORITY_ATTENTION_THRESHOLD=0.75

# =====================================================
# RATE LIMITING
# =====================================================
# Storage backend for rate limiting
# Use memory:// for single-server deployments
# For distributed deployments, use Redis: redis://host:port/db
# Example Redis: redis://default:password@host:6379
RATELIMIT_STORAGE_URI=memory://

# =====================================================
# PAYMENT & UPI CONFIGURATION - REQUIRED
# =====================================================
# Your UPI Virtual Payment Address (VPA)
# Example: yourbusiness@upi
UPI_VPA=

# Your business/personal name for UPI payments
UPI_NAME=

# Payment signature secret - REQUIRED
# Use a long random string to sign payment requests
# Generate with: openssl rand -hex 32
PAYMENT_SECRET=

# Payment configuration
PAYMENT_AMOUNT=1
PAYMENT_CURRENCY=INR
PAYMENT_EXPIRY_SECONDS=300

# =====================================================
# AWS S3 CONFIGURATION - REQUIRED FOR PAYMENTS
# =====================================================
# AWS credentials for payment proof uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS region (e.g., ap-south-1, us-east-1)
AWS_REGION=ap-south-1

# S3 bucket name for storing payment proof files
S3_BUCKET=cognitapi

# =====================================================
# OCR & IMAGE PROCESSING
# =====================================================
# Minimum OCR confidence for payment verification (0-100)
MIN_OCR_CONFIDENCE=55

# Minimum image width for payment screenshots
MIN_IMAGE_WIDTH=600

# Allowed image extensions for uploads
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# =====================================================
# PERFORMANCE & MONITORING
# =====================================================
# Performance logging sample rate (0.0 to 1.0)
# 0.10 = 10% of requests will be logged
PERFORMANCE_LOG_SAMPLE_RATE=0.10

# =====================================================
# SERVER CONFIGURATION
# =====================================================
# Port for the application (default: 5000)
PORT=5000

# Number of workers for Gunicorn (auto-calculated if not set)
# GUNICORN_WORKERS=2

# Number of threads per worker (default: 4)
# GUNICORN_THREADS=4

# Worker class: 'sync' (default) or 'gevent' for async
# GUNICORN_WORKER_CLASS=sync

# Worker timeout in seconds (default: 60)
# GUNICORN_TIMEOUT=60

# Keep connections alive (default: 5 seconds)
# GUNICORN_KEEPALIVE=5

# Restart workers after N requests (default: 1000)
# GUNICORN_MAX_REQUESTS=1000

# Random jitter for max_requests (default: 50)
# GUNICORN_MAX_REQUESTS_JITTER=50

# Log level: debug, info, warning, error, critical
# GUNICORN_LOG_LEVEL=info

# Gunicorn bind address (default: 0.0.0.0:5000)
# GUNICORN_BIND=0.0.0.0:5000

# =====================================================
# DEPLOYMENT CONFIGURATION
# =====================================================
# Vercel environment indicator
VERCEL_ENV=development

# =====================================================
# INTERNAL VERIFICATION
# =====================================================
# Internal API key for payment verification (internal use only)
# INTERNAL_VERIFICATION_KEY=

# =====================================================
# AWS TEXTRACT OCR CONFIGURATION
# =====================================================
# OCR is handled by Amazon Textract service
# No local Tesseract installation required
# AWS credentials (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY) are used for Textract
# Ensure your AWS account has Textract permissions enabled

# =====================================================
# LOGGING CONFIGURATION
# =====================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =====================================================
# FRAUD DETECTION
# =====================================================
# Maximum allowed fraud score (0-100)
MAX_FRAUD_SCORE=50.0

# Duplicate screenshot detection
ENABLE_DUPLICATE_DETECTION=true

# =====================================================
# ADVANCED FEATURES
# =====================================================
# Enable device fingerprinting
ENABLE_DEVICE_FINGERPRINTING=true

# Enable audit logging
ENABLE_AUDIT_LOGGING=true

# Enable error logging
ENABLE_ERROR_LOGGING=true

# =====================================================
# TESTING CONFIGURATION
# =====================================================
# Set to true to enable test mode (bypass payments, etc.)
TEST_MODE=false

# Test payment amount (when TEST_MODE=true)
TEST_PAYMENT_AMOUNT=0

# =====================================================
# OPTIONAL: EXTERNAL SERVICES
# =====================================================
# Redis URL for caching (if different from rate limiting)
# REDIS_URL=

# Sentry DSN for error tracking
# SENTRY_DSN=

# =====================================================
# OPTIONAL: ANALYTICS & TRACKING
# =====================================================
# Google Analytics tracking ID
# GA_TRACKING_ID=

# Enable query performance tracking
ENABLE_QUERY_TRACKING=false

# =====================================================
# OPTIONAL: EMAIL CONFIGURATION
# =====================================================
# SMTP settings for sending emails (if needed)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true

# =====================================================
# NOTES
# =====================================================
# 1. Copy this file to .env and fill in the values
# 2. Never commit .env to version control
# 3. Generate random secrets using the commands provided
# 4. For production, use strong, unique values for all secrets
# 5. Ensure DATABASE_URL and S3 credentials are correct
# 6. Required fields must be set before starting the application
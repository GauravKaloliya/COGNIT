# =====================================================
# C.O.G.N.I.T. Backend Environment Variables
# =====================================================

# Database Configuration
# PostgreSQL connection string - Required
# Format: postgresql://username:password@host:port/database
DATABASE_URL=

# Flask Configuration
# Required - use a long random string in production
SECRET_KEY=

# Website URL
# Used for API documentation base URL
WEBSITE_URL=

# Proxy Configuration
# Set to 'true' or '1' if behind a reverse proxy (e.g., Vercel, nginx)
# This enables ProxyFix middleware to prevent IP spoofing
BEHIND_PROXY=false

# CORS Configuration
# Comma-separated list of allowed origins
# Example: https://cognit.online,https://www.cognit.online
CORS_ORIGINS=

# Application Configuration
MIN_WORD_COUNT=60
TOO_FAST_SECONDS=5

# Performance logging sampling rate (0.0 to 1.0, default: 0.1)
PERFORMANCE_LOG_SAMPLE_RATE=0.1

# Email domain restrictions
# Comma-separated list of allowed email domains
# Example: gmail.com,outlook.com,hotmail.com,icloud.com
# Leave empty to use default list
ALLOWED_EMAIL_DOMAINS=

# IP anonymization salt - Required, use a long random string
IP_HASH_SALT=

# Rate Limiting Storage Backend
# Use memory:// for single-server deployments
# For distributed deployments, use Redis: redis://host:port/db
RATELIMIT_STORAGE_URI=memory://

# =====================================================
# Gunicorn Configuration (for Docker/Container deployment)
# =====================================================

# Gunicorn server binding address (default: 0.0.0.0:5000)
# GUNICORN_BIND=0.0.0.0:5000

# Number of worker processes (default: auto-calculated based on CPU cores)
# GUNICORN_WORKERS=2

# Number of threads per worker (default: 4)
# GUNICORN_THREADS=4

# Worker class: 'sync' (default) or 'gevent' for async
# GUNICORN_WORKER_CLASS=sync

# Worker silent timeout in seconds (default: 60)
# GUNICORN_TIMEOUT=60

# Keep connections alive for this many seconds (default: 5)
# GUNICORN_KEEPALIVE=5

# Restart workers after this many requests (default: 1000)
# GUNICORN_MAX_REQUESTS=1000

# Random jitter for max_requests (default: 50)
# GUNICORN_MAX_REQUESTS_JITTER=50

# Log level: debug, info, warning, error, critical (default: info)
# GUNICORN_LOG_LEVEL=info

# =====================================================
# C.O.G.N.I.T. Backend Environment Variables v2.0
# =====================================================

# Database Configuration
# PostgreSQL connection string - Required for production
# Format: postgresql://username:password@host:port/database
DATABASE_URL=

# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_DEBUG=0

# Website URL
# Used for API documentation and other reference purposes
# Production: https://www.cognit.online
WEBSITE_URL=http://localhost:5173

# CORS Configuration
# Comma-separated list of allowed origins for CORS
# For production, list your frontend domain(s)
# When not set, defaults to: http://localhost:5173 and http://localhost:3000 (localhost only)
# Override this to set custom origins, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://www.cognit.online
CORS_ORIGINS=

# Application Configuration
MIN_WORD_COUNT=60
TOO_FAST_SECONDS=5
IP_HASH_SALT=local-salt-change-this-in-production

# =====================================================
# UPI Payment Configuration (v2.0 - Redesigned)
# =====================================================

# Your UPI ID for receiving payments (e.g., yourname@upi)
UPI_ID=
# Display name for the payee in UPI apps
UPI_PAYEE_NAME=
# Entry fee amount in paise (100 = ₹1)
PAYMENT_AMOUNT=100

# =====================================================
# AWS S3 Configuration (v2.0 - Enhanced)
# =====================================================

# AWS Access Key ID with S3 permissions
AWS_ACCESS_KEY_ID=
# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=
# AWS Region (default: us-east-1)
AWS_REGION=us-east-1
# S3 Bucket Name for storing all images
S3_BUCKET_NAME=

# S3 Key Prefixes
# Payment proofs prefix (default: payment-proofs/)
S3_PAYMENT_PROOFS_PREFIX=payment-proofs/

# =====================================================
# Rate Limiting Storage Backend
# =====================================================

# Use memory:// for single-server deployments
# For distributed/multi-server deployments, use Redis: redis://host:port/db
# If Redis is configured but unavailable, the app will automatically fall back to memory storage
# Examples:
#   RATELIMIT_STORAGE_URI=memory://
#   RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# =====================================================
# Server Configuration
# =====================================================

# PORT is set automatically by Render.com/Vercel
# Uncomment and set manually for local development
# PORT=5000

# =====================================================
# Gunicorn Configuration (for Docker/Container deployment)
# =====================================================

# Gunicorn server binding address (default: 0.0.0.0:5000)
# GUNICORN_BIND=0.0.0.0:5000

# Number of worker processes (default: auto-calculated based on CPU cores)
# Recommended: 2-4 workers for most applications
# GUNICORN_WORKERS=2

# Number of threads per worker (default: 4)
# GUNICORN_THREADS=4

# Worker class: 'sync' (default) or 'gevent' for async
# GUNICORN_WORKER_CLASS=sync

# Worker silent timeout in seconds (default: 60)
# GUNICORN_TIMEOUT=60

# Keep connections alive for this many seconds (default: 5)
# GUNICORN_KEEPALIVE=5

# Restart workers after this many requests (prevents memory leaks, default: 1000)
# GUNICORN_MAX_REQUESTS=1000

# Random jitter for max_requests to prevent all workers restarting at once (default: 50)
# GUNICORN_MAX_REQUESTS_JITTER=50

# Log level: debug, info, warning, error, critical (default: info)
# GUNICORN_LOG_LEVEL=info

# Custom access log format (default: %(m)s %(U)s %(s)s %(L)ss)
# GUNICORN_ACCESS_LOG_FORMAT=%(m)s %(U)s %(s)s %(L)ss

# =====================================================
# v2.0 Features (No longer needed)
# =====================================================

# RAZORPAY Integration - REMOVED
# The following variables are no longer used:
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
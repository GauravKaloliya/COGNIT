# =====================================================
# C.O.G.N.I.T. PRODUCTION ENVIRONMENT
# =====================================================
# This file contains production environment variables
# DO NOT commit actual secrets to version control
# Use .env.production.template as a reference

# --- Core App ---
WEBSITE_URL=https://cognit.online
VERCEL_ENV=production
LOG_LEVEL=INFO

# --- Fraud & Moderation ---
MAX_FRAUD_SCORE=50.0
ENABLE_DUPLICATE_DETECTION=true
ENABLE_DEVICE_FINGERPRINTING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ERROR_LOGGING=true
MIN_OCR_CONFIDENCE=55
MIN_IMAGE_WIDTH=600
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# --- UPI / Payment ---
UPI_VPA=yourbusiness@upi
UPI_NAME=Your Business Name
PAYMENT_AMOUNT=1

# --- Priority & Attention Logic ---
PRIORITY_ROUNDS_THRESHOLD=3
PRIORITY_ATTENTION_THRESHOLD=0.75
PRIORITY_WORD_THRESHOLD=500
ATTENTION_FLAG_THRESHOLD=0.60
ATTENTION_FLAG_MIN_CHECKS=3
TOO_FAST_SECONDS=5

# --- Content Validation ---
MIN_DESCRIPTION_LENGTH=60
MAX_DESCRIPTION_LENGTH=10000
MIN_FEEDBACK_LENGTH=5
MAX_FEEDBACK_LENGTH=2000
MIN_RATING=1
MAX_RATING=10
MIN_WORD_COUNT=60

# --- Performance ---
PERFORMANCE_LOG_SAMPLE_RATE=0.10

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=cognitapi

# --- Security ---
IP_HASH_SALT=production-ip-hash-salt-minimum-32-chars

# --- Backend Config ---
CORS_ORIGINS=https://cognit.online
DATABASE_URL=postgresql://neondb_owner:password@ep-rough-sunset-aiwm9van-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
FLASK_ENV=production
PORT=5000
RATELIMIT_STORAGE_URI=rediss://default:password@dear-raptor-34179.upstash.io:6379
SECRET_KEY=Gaurav0809-production-secret-minimum-32-chars

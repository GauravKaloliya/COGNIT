MIN_RATING=1
MAX_RATING=10
TOO_FAST_SECONDS=5
SURVEY_ROUNDS=1
PRIORITY_MIN_SUBMISSIONS=3

# =====================================================
# PAYMENT CONFIGURATION
# =====================================================

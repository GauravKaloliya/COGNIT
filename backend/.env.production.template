# =====================================================
# C.O.G.N.I.T. PRODUCTION ENVIRONMENT TEMPLATE
# =====================================================
# WARNING: Copy this to .env and fill in real values
# NEVER commit .env with real secrets to version control
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"

# --- Core App ---
WEBSITE_URL=https://cognit.online
VERCEL_ENV=production
LOG_LEVEL=INFO

# --- Fraud & Moderation ---
MAX_FRAUD_SCORE=50.0
ENABLE_DUPLICATE_DETECTION=true
ENABLE_DEVICE_FINGERPRINTING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ERROR_LOGGING=true
MIN_OCR_CONFIDENCE=55
MIN_IMAGE_WIDTH=600
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# --- UPI / Payment ---
UPI_VPA=yourbusiness@upi
UPI_NAME=Your Business Name
PAYMENT_AMOUNT=1

# --- Priority & Attention Logic ---
PRIORITY_ROUNDS_THRESHOLD=3
PRIORITY_ATTENTION_THRESHOLD=0.75
PRIORITY_WORD_THRESHOLD=500
ATTENTION_FLAG_THRESHOLD=0.60
ATTENTION_FLAG_MIN_CHECKS=3
TOO_FAST_SECONDS=5.0

# --- Content Validation ---
MIN_DESCRIPTION_LENGTH=60
MAX_DESCRIPTION_LENGTH=10000
MIN_FEEDBACK_LENGTH=5
MAX_FEEDBACK_LENGTH=2000
MIN_RATING=1
MAX_RATING=10
MIN_WORD_COUNT=60

# --- Performance ---
PERFORMANCE_LOG_SAMPLE_RATE=0.10

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=cognitapi

# --- Security ---
IP_HASH_SALT=

# --- Backend Config ---
# CORS_ORIGINS: Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://cognit.online,https://www.cognit.online
CORS_SUPPORTS_CREDENTIALS=true
DATABASE_URL=postgresql://username:password@ep-xxx.aws.neon.tech/db?sslmode=require&channel_binding=require
FLASK_ENV=production
PORT=5000
RATELIMIT_STORAGE_URI=rediss://default:password@host:6379
SECRET_KEY=

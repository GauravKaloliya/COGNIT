# =====================================================
# C.O.G.N.I.T. PRODUCTION ENVIRONMENT
# =====================================================
# WARNING: This is a template for production deployment
# Copy values from your actual production environment

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
# PostgreSQL connection string (Neon example)
DATABASE_URL="postgresql://username:password@ep-xxx.aws.neon.tech/db?sslmode=require&channel_binding=require"

# =====================================================
# FLASK CONFIGURATION
# =====================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="your-secret-key-here-32-chars-minimum"

FLASK_ENV=production

# =====================================================
# APPLICATION BASE URL
# =====================================================
WEBSITE_URL=https://cognit.online

# CORS Configuration
CORS_ORIGINS=https://cognit.online,https://www.cognit.online

# =====================================================
# SECURITY & HASHING
# =====================================================
# Generate with: openssl rand -hex 32
IP_HASH_SALT="your-ip-hash-salt-here-32-chars-minimum"

# =====================================================
# SURVEY CONFIGURATION
# =====================================================
MIN_WORD_COUNT=60
MIN_DESCRIPTION_LENGTH=60
MAX_DESCRIPTION_LENGTH=10000
MIN_FEEDBACK_LENGTH=5
MAX_FEEDBACK_LENGTH=2000
MIN_RATING=1
MAX_RATING=10
TOO_FAST_SECONDS=5.0
SURVEY_ROUNDS=1
PRIORITY_MIN_SUBMISSIONS=3

# =====================================================
# ATTENTION & QUALITY CHECKING
# =====================================================
ATTENTION_FLAG_THRESHOLD=0.60
ATTENTION_FLAG_MIN_CHECKS=3
PRIORITY_WORD_THRESHOLD=500
PRIORITY_ROUNDS_THRESHOLD=3
PRIORITY_ATTENTION_THRESHOLD=0.75

# =====================================================
# RATE LIMITING
# =====================================================
# Redis URL for distributed rate limiting
RATELIMIT_STORAGE_URI=rediss://default:password@host:6379

# =====================================================
# PAYMENT & UPI CONFIGURATION
# =====================================================
# Your UPI Virtual Payment Address (VPA)
UPI_VPA="yourbusiness@upi"

# Your business/personal name
UPI_NAME="Your Business Name"

# Payment signature secret
# Generate with: openssl rand -hex 32
PAYMENT_SECRET="your-payment-secret-here-32-chars-minimum"

PAYMENT_AMOUNT=1
PAYMENT_CURRENCY=INR
PAYMENT_EXPIRY_SECONDS=300

# =====================================================
# AWS S3 CONFIGURATION
# =====================================================
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
S3_BUCKET=cognitapi

# =====================================================
# OCR & IMAGE PROCESSING
# =====================================================
MIN_OCR_CONFIDENCE=55
MIN_IMAGE_WIDTH=600
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp

# =====================================================
# PERFORMANCE & MONITORING
# =====================================================
PERFORMANCE_LOG_SAMPLE_RATE=0.10

# =====================================================
# SERVER CONFIGURATION
# =====================================================
PORT=5000

# =====================================================
# DEPLOYMENT CONFIGURATION
# =====================================================
VERCEL_ENV=production

# =====================================================
# LOGGING CONFIGURATION
# =====================================================
LOG_LEVEL=INFO

# =====================================================
# FRAUD DETECTION
# =====================================================
MAX_FRAUD_SCORE=50.0
ENABLE_DUPLICATE_DETECTION=true

# =====================================================
# ADVANCED FEATURES
# =====================================================
ENABLE_DEVICE_FINGERPRINTING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ERROR_LOGGING=true

# =====================================================
# TESTING
# =====================================================
TEST_MODE=false
TEST_PAYMENT_AMOUNT=0
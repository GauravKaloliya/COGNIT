# C.O.G.N.I.T. backend production template

# Core URLs
WEBSITE_URL=https://cognit.online
DOCS_BASE_URL=https://api.cognit.online

# Database
DATABASE_URL=
DATABASE_SSLMODE=auto
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300

# Security
SECRET_KEY=
IP_HASH_SALT=
CORS_ORIGINS=https://cognit.online,https://www.cognit.online
CORS_SUPPORTS_CREDENTIALS=true
TRUST_PROXY_HEADERS=true
RATELIMIT_STORAGE_URI=redis://
PARTICIPANT_SESSION_STALE_TTL_SECONDS=600

# Turnstile
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_SECONDS=3.5

# Survey validation
MIN_WORD_COUNT=60
MIN_DESCRIPTION_LENGTH=60
MAX_DESCRIPTION_LENGTH=10000
MIN_FEEDBACK_LENGTH=5
MAX_FEEDBACK_LENGTH=2000
MIN_RATING=1
MAX_RATING=5
TOO_FAST_SECONDS=5.0
ATTENTION_MIN_RECALL=0.4

# Email OTP
EMAIL_OTP_LENGTH=6
EMAIL_OTP_EXPIRY_SECONDS=300
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_WEBHOOK_URL=
EMAIL_OTP_SENDER=verify@cognit.online
EMAIL_OTP_SUBJECT=Verification COGNIT
EMAIL_OTP_HTML_TEMPLATE=<p><strong>COGNIT</strong></p><p>Enter this verification code:</p><p style="font-size:20px;font-weight:600;letter-spacing:2px;">{otp}</p>
EMAIL_OTP_WEBHOOK_TIMEOUT_SECONDS=15
EMAIL_OTP_JWT_SECRET=
EMAIL_OTP_JWT_TTL_SECONDS=3600

# Runtime and observability
PORT=5000
FLASK_DEBUG=false
SUPPRESS_ACCESS_LOGS=true
ENABLE_DEVICE_FINGERPRINTING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ERROR_LOGGING=true
ENABLE_REQUEST_DB_OBSERVABILITY=false
DEVICE_FINGERPRINT_SALTS=
APP_PROCESS_ROLE=web

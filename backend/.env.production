# =====================================================
# C.O.G.N.I.T. Backend Environment Variables (Production)
# =====================================================

# --- Core App ---
WEBSITE_URL=https://example.com
DOCS_BASE_URL=https://api.example.com

# Cookies (optional)
# SESSION_COOKIE_SECURE defaults based on WEBSITE_URL (https -> true)
SESSION_COOKIE_SECURE=
# SESSION_COOKIE_SAMESITE defaults based on SESSION_COOKIE_SECURE (https -> None, else Lax)
SESSION_COOKIE_SAMESITE=

# --- Content Validation ---
MIN_WORD_COUNT=60
MIN_DESCRIPTION_LENGTH=60
MAX_DESCRIPTION_LENGTH=10000
MIN_FEEDBACK_LENGTH=5
MAX_FEEDBACK_LENGTH=2000
MIN_RATING=1
MAX_RATING=10
TOO_FAST_SECONDS=5.0

# --- Email OTP ---
EMAIL_OTP_LENGTH=6
EMAIL_OTP_EXPIRY_SECONDS=300
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_WEBHOOK_URL=
EMAIL_OTP_SENDER=verify@cognit.online
EMAIL_OTP_SUBJECT=Verification COGNIT
EMAIL_OTP_HTML_TEMPLATE=<p><strong>COGNIT</strong></p><p>Enter this verification code to continue:</p><p style="font-size:20px;font-weight:600;letter-spacing:2px;">{otp}</p><p>Please ignore this email if this wasn't you trying to create a COGNIT participant account.</p><p>Best,<br>The COGNIT team<br>COGNIT</p>
EMAIL_OTP_WEBHOOK_TIMEOUT_SECONDS=15
EMAIL_OTP_JWT_SECRET=
EMAIL_OTP_JWT_TTL_SECONDS=3600

# --- Turnstile / Bot Defense ---
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=0x4AAAAAACnWDgvkCIZmv1rIoQSkdvU5-ok
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_TIMEOUT_SECONDS=3.5
TURNSTILE_BYPASS_LOCAL=false

# --- Security / Validation ---
IMAGE_VALIDATE_URL_AVAILABILITY=false
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp
ENABLE_DUPLICATE_DETECTION=true
ENABLE_DEVICE_FINGERPRINTING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_ERROR_LOGGING=true
SUPPRESS_ACCESS_LOGS=true
DEVICE_FINGERPRINT_SALTS=cognit_fingerprint_salt_2026
FORCE_ATTENTION_IMAGES=false

# --- AWS / S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=cognitapi

# --- Security ---
IP_HASH_SALT=
SECRET_KEY=

# --- Database ---
DATABASE_URL=
DATABASE_SSLMODE=auto

# --- CORS / Rate Limiting ---
CORS_ORIGINS=https://www.cognit.online,https://cognit.online,https://api.cognit.online
CORS_SUPPORTS_CREDENTIALS=true
TRUST_PROXY_HEADERS=true
RATELIMIT_STORAGE_URI=memory://

# --- Image Pool ---
IMAGE_PICK_ATTEMPTS_ATTENTION=4
IMAGE_PICK_ATTEMPTS_NON_ATTENTION=4

# --- Runtime (optional) ---
PORT=5000
FLASK_DEBUG=false

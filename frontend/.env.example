# =============================================================================
# C.O.G.N.I.T. Frontend Environment Configuration
# =============================================================================
# Copy this file to .env.local for local development
# For production, set these as environment variables in Vercel dashboard
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API Configuration (REQUIRED for production)
# -----------------------------------------------------------------------------
# - Leave empty for same-origin requests (when frontend and backend share domain)
# - Set to full URL for separate backend deployment
# - MUST NOT have trailing slash
# Examples:
#   VITE_API_BASE=                    # Empty = same origin (default)
#   VITE_API_BASE=https://api.example.com
#   VITE_API_BASE=https://my-backend.vercel.app
VITE_API_BASE=

# -----------------------------------------------------------------------------
# Content Validation Settings
# -----------------------------------------------------------------------------
VITE_MIN_WORDS=60
VITE_MIN_DESCRIPTION_LENGTH=60
VITE_MAX_DESCRIPTION_LENGTH=10000
VITE_MIN_FEEDBACK_LENGTH=5
VITE_MAX_FEEDBACK_LENGTH=2000

# -----------------------------------------------------------------------------
# Payment Configuration
# -----------------------------------------------------------------------------
VITE_PAYMENT_AMOUNT=1
VITE_PAYMENT_CURRENCY=INR
VITE_PAYMENT_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# User Registration Validation
# -----------------------------------------------------------------------------
VITE_USERNAME_MIN_LENGTH=2
VITE_AGE_MIN=13
VITE_AGE_MAX=100
VITE_LOCATION_MIN_LENGTH=2

# -----------------------------------------------------------------------------
# API Rate Limiting (client-side display)
# -----------------------------------------------------------------------------
VITE_API_RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# Survey Configuration
# -----------------------------------------------------------------------------
VITE_SURVEY_ROUNDS=1
VITE_MIN_SURVEY_WORD_COUNT=60
VITE_PRIORITY_MIN_SUBMISSIONS=3

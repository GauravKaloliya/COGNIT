# Vite Environment Variables
# Copy this file to .env.local for local development

# Backend API Base URL
# - Leave empty for same-origin requests (when frontend and backend share the same domain)
# - Set to full URL for separate backend (e.g., https://your-backend.vercel.app)
VITE_API_BASE=

# Example for separate backend deployment:
# VITE_API_BASE=https://your-backend-url.vercel.app

# Application Configuration
VITE_MIN_WORDS=60
VITE_MIN_DESCRIPTION_LENGTH=60
VITE_MAX_DESCRIPTION_LENGTH=10000
VITE_MIN_FEEDBACK_LENGTH=5
VITE_MAX_FEEDBACK_LENGTH=2000

# Participant Validation Configuration
VITE_USERNAME_MIN_LENGTH=2
VITE_AGE_MIN=13
VITE_AGE_MAX=100
VITE_LOCATION_MIN_LENGTH=2

# =============================================================================
# C.O.G.N.I.T. Frontend Environment (Template)
# =============================================================================
# Copy to .env.local for development or set in Vercel environment variables.

# Backend API base URL
# Empty means same-origin (frontend and backend on same domain)
VITE_API_BASE=

# Submission validation limits (must align with backend)
VITE_MIN_WORDS=60
VITE_MIN_DESCRIPTION_LENGTH=60
VITE_MAX_DESCRIPTION_LENGTH=10000
VITE_MIN_FEEDBACK_LENGTH=5
VITE_MAX_FEEDBACK_LENGTH=2000

# Upload constraints (must be <= backend MAX_CONTENT_LENGTH_MB)
VITE_MAX_UPLOAD_MB=8
VITE_PAYMENT_UPLOAD_MAX_MB=8
VITE_DISABLE_COPY_PASTE=false

# User details validation
VITE_USERNAME_MIN_LENGTH=2
VITE_AGE_MIN=13
VITE_AGE_MAX=100
VITE_LOCATION_MIN_LENGTH=2

# Runtime tuning
VITE_UI_STATE_SCHEMA_VERSION=1
VITE_UI_STATE_TTL_MS=900000
VITE_MS_PER_SECOND=1000
VITE_COUNTDOWN_TICK_MS=1000
VITE_ACTIVE_TAB_LOCK_SCHEMA_VERSION=1
VITE_ACTIVE_TAB_HEARTBEAT_MS=4000
VITE_ACTIVE_TAB_STALE_MS=15000
VITE_TOAST_DEDUPE_WINDOW_MS=2000
VITE_TOAST_AUTO_DISMISS_MS=4000
VITE_CONFETTI_DURATION_MS=1200
VITE_SERVICE_RETRY_SECONDS=5
VITE_PAYMENT_RETRY_SECONDS=5
VITE_TURNSTILE_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
VITE_PAYMENT_STATE_SCHEMA_VERSION=1
VITE_PAYMENT_STATE_TTL_MS=900000
VITE_PAYMENT_CREATE_TIMEOUT_MS=15000
VITE_PAYMENT_TIMER_DURATION_MS=300000
VITE_PAYMENT_TIMER_TICK_MS=1000
VITE_PAYMENT_AMOUNT=1
VITE_REWARD_AMOUNT=10
VITE_MIN_SCREENSHOT_WIDTH=360
VITE_MIN_SCREENSHOT_HEIGHT=640
VITE_MIN_LAPLACIAN_VARIANCE=22
VITE_SURVEY_DRAFT_SCHEMA_VERSION=1
VITE_SURVEY_DRAFT_TTL_MS=900000
VITE_CONSENT_DRAFT_SCHEMA_VERSION=1
VITE_CONSENT_DRAFT_TTL_MS=900000
VITE_PRIORITY_DESC_WORD_TARGET=120
VITE_PRIORITY_FEEDBACK_TARGET=60
VITE_SURVEY_UI_TOTAL_STEPS=2
VITE_SUBMIT_UNLOCK_DELAY_MS=900
VITE_SUBMIT_UNLOCK_INVALID_DELAY_MS=500
VITE_SUBMIT_UNLOCK_COMPLETE_DELAY_MS=1000
VITE_SURVEY_TIMER_TICK_MS=1000
VITE_HEALTH_CHECK_TIMEOUT_MS=10000
VITE_HEALTH_CHECK_INTERVAL_MS=30000
VITE_NETWORK_PROBE_TIMEOUT_MS=4000
VITE_NETWORK_PROBE_INTERVAL_MS=10000
VITE_NETWORK_PROBE_FAIL_THRESHOLD=2
VITE_GEOLOCATION_TIMEOUT_MS=10000
VITE_GEOLOCATION_MAX_AGE_MS=300000
VITE_REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
VITE_REVERSE_GEOCODE_TTL_MS=300000
VITE_AVAILABILITY_DEBOUNCE_MS=500
VITE_DEV_PROXY_TARGET=http://localhost:5000

# Storage keys (override to change session/local storage keys)
VITE_KEY_ACTIVE_TAB_LOCK=cognit_active_tab_lock_v1
VITE_KEY_DARK_MODE=darkMode
VITE_KEY_STAGE=stage
VITE_KEY_PAYMENT_SUB_STAGE=paymentSubStage
VITE_KEY_CONSENT_GIVEN=consentGiven
VITE_KEY_USER_DETAILS_SUBMITTED=userDetailsSubmitted
VITE_KEY_PAYMENT_VERIFIED=paymentVerified
VITE_KEY_DEMOGRAPHICS=demographics
VITE_KEY_SURVEY=survey
VITE_KEY_SURVEY_COMPLETED=surveyCompleted
VITE_KEY_SURVEY_FEEDBACK_READY=surveyFeedbackReady
VITE_KEY_LAST_SUBMISSION_SUCCEEDED=lastSubmissionSucceeded
VITE_KEY_SHOWN_IMAGES=shownImages
VITE_KEY_SESSION_ID=sessionId
VITE_KEY_PUBLIC_ID=publicId
VITE_KEY_CONSENT_DRAFT=consent_checked_draft
VITE_KEY_CONSENT_PENDING=consent_pending_submit_v1
VITE_KEY_USER_DETAILS_PENDING=user_details_pending_submit_v1
VITE_KEY_PARTICIPANT_OPTIONS=participant_options_v1
VITE_KEY_AUTO_LOCATION_PROMPT=location_auto_prompt_v1
VITE_KEY_REVERSE_GEOCODE_STATE=reverse_geocode_state_v1
VITE_KEY_PAYMENT_CONTENT_PENDING=payment_content_pending_continue_v1
VITE_KEY_PAYMENT_STATE=payment_link_state_v1
VITE_KEY_PAYMENT_TIMER_EXPIRES=payment_timer_expires_at
VITE_KEY_PAYMENT_ID=payment_id
VITE_KEY_PAYMENT_PENDING_CREATE=payment_pending_create_v1
VITE_KEY_PAYMENT_PENDING_VERIFY=payment_pending_verify_v1
VITE_KEY_SURVEY_DRAFT_PREFIX=survey_draft
VITE_KEY_SURVEY_DRAFT_ACTIVE_PREFIX=survey_draft_active
VITE_KEY_SURVEY_PENDING_SUBMIT=survey_pending_submit_v1
VITE_KEY_SURVEY_FEED_PENDING_CONTINUE=survey_feed_pending_continue_v1
VITE_KEY_SURVEY_FEED_PENDING_FINISH=survey_feed_pending_finish_v1
VITE_KEY_TELEMETRY=client_telemetry_v1

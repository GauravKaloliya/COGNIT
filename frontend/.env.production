# C.O.G.N.I.T. frontend production template

# API
VITE_API_BASE=https://api.cognit.online

# Turnstile
VITE_TURNSTILE_ENABLED=true
VITE_TURNSTILE_SITE_KEY=

# User detail UX
VITE_ALLOWED_EMAIL_DOMAINS=gmail.com,outlook.com,hotmail.com,icloud.com,me.com,mac.com
VITE_EMAIL_PLACEHOLDER_ROTATE_MS=1800

# Survey validation
VITE_MIN_WORDS=60
VITE_MIN_DESCRIPTION_LENGTH=60
VITE_MAX_DESCRIPTION_LENGTH=10000
VITE_MIN_FEEDBACK_LENGTH=5
VITE_MAX_FEEDBACK_LENGTH=2000
VITE_MIN_RATING=1
VITE_MAX_RATING=5

# Input restrictions
VITE_DISABLE_COPY_PASTE=true

# User details validation
VITE_USERNAME_MIN_LENGTH=2
VITE_AGE_MIN=13
VITE_AGE_MAX=100
VITE_LOCATION_MIN_LENGTH=2

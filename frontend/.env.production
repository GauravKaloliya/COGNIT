# Production Environment Configuration
# Use empty value for same-origin requests (when frontend and backend are on same domain)
# For separate domains, set this to your backend URL (e.g., https://your-backend.vercel.app)
VITE_API_BASE=

# Production settings
VITE_PAYMENT_AMOUNT=1
VITE_PAYMENT_CURRENCY=INR
VITE_PAYMENT_TIMEOUT_SECONDS=300
VITE_MIN_WORDS=60
VITE_MIN_DESCRIPTION_LENGTH=60
VITE_MAX_DESCRIPTION_LENGTH=10000
VITE_MIN_FEEDBACK_LENGTH=5
VITE_MAX_FEEDBACK_LENGTH=2000
VITE_SURVEY_ROUNDS=1
VITE_PRIORITY_MIN_SUBMISSIONS=3
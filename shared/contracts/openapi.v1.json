{
  "openapi": "3.0.3",
  "info": {
    "title": "COGNIT Public API",
    "version": "1.0.0",
    "description": "Client-agnostic API contract for participant onboarding, payment verification, survey, and submission."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "category",
              "http_status",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "http_status": {
                "type": "integer"
              },
              "retryable": {
                "type": "boolean"
              },
              "request_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/participants": {
      "post": {
        "responses": {
          "200": {
            "description": "created"
          }
        }
      }
    },
    "/check-username": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/check-email": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/check-phone": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/consent": {
      "post": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/payments/create": {
      "post": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/payments/{payment_public_id}/status": {
      "get": {
        "parameters": [
          {
            "name": "payment_public_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/payments/{payment_public_id}/verify-upload": {
      "post": {
        "parameters": [
          {
            "name": "payment_public_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/images/random": {
      "get": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/submit": {
      "post": {
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    }
  }
}
